# Indian Food Vision AI — backend config template.
# Copy to `.env` and fill in the values you care about. Everything is
# optional — the backend boots fine with nothing set.

# --- Optional AI vision enhancement -----------------------------------
# Drop in the full HTTP config of any multimodal LLM provider and the
# backend will use it to refine predictions and estimate portions.
# Leave these blank to skip it — the local classifier + CLIP fallback
# still work fine on their own.
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_ENDPOINT=
AI_VISION_API_VERSION=
AI_VISION_API_VERSION_HEADER=
AI_VISION_TIMEOUT_S=30

# --- Model paths (relative to backend/) -------------------------------
MODEL_CHECKPOINT_PATH=checkpoints/best_model.pth
CLASS_MAP_PATH=app/data/class_map.json
NUTRITION_DB_PATH=app/data/nutrition_db.json

# --- CLIP zero-shot fallback ------------------------------------------
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
USE_CLIP_FALLBACK=true

# --- HTTP server ------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Voice assistant -------------------------------------------------
GROQ_API_KEY=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
OPENAI_API_KEY=AQ.Ab8RN6IuIHRHbz8N8CQuZhqliOs58eEBzfFIlXbe1fwm0J5Ycw
SARVAM_API_KEY=sk_8bgcrq01_FpStzZURLMwwG56tuQ4dVCda
ELEVENLABS_API_KEY=sk_6fbd5483f13551a68bc238bf8ad78a3d02840c6ebee763e5
CHROMA_PERSIST_DIR=app/data/chroma_store
DEFAULT_TTS_LANGUAGE=en
VOICE_SESSION_TTL_MINUTES=30
MAX_HISTORY_TURNS=6
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
